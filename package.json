{
  "name": "draft-rescue",
  "displayName": "Draft Rescue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Never lose what you typed. Saves your drafts locally, on your own machine.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "size": "node scripts/check-size.mjs",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:dev": "wxt build -m development",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "smoke:restore": "node scripts/smoke-restore.mjs",
    "smoke:prompt": "node scripts/smoke-prompt.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
